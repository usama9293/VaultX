{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=VaultXDb;Username=YOUR_USERNAME;Password=YOUR_PASSWORD"
  },
  "JwtSettings": {
    "Issuer": "VaultX.API",
    "Audience": "VaultX.Client",
    "SecretKey": "YOUR_DEVELOPMENT_OR_PRODUCTION_JWT_SECRET_KEY_MINIMUM_32_BYTES_LONG",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
